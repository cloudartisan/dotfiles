#!/bin/sh

# Install brew if it is not already installed
command -v brew >/dev/null 2>&1 || \
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Make sure we're using the latest Homebrew
brew update

# Homebrew no longer requires explicit tapping of the main repositories
# as they've been integrated into the core Homebrew experience

# Install all common dependencies using Brewfile
brew bundle --file="$HOME/Brewfile"

# Install personal-only packages if present (personal machines only;
# Brewfile.personal is not deployed on work machines)
if [ -f "$HOME/Brewfile.personal" ]; then
  brew bundle --file="$HOME/Brewfile.personal"
fi

# Remove cached downloads and outdated versions
brew cleanup