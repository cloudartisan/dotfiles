#!/bin/bash

# Enable GitHub secret scanning and push protection on every public repository
# owned by a given account, and report any open alerts.
#
# A personal GitHub account has no way to default these on: bulk enablement via
# security configurations is an organisation-owner feature, and the REST API
# exposes no equivalent user-level setting. New repositories therefore start
# with both disabled, so this sweep needs repeating.
#
# Run by ~/Library/LaunchAgents/com.cloudartisan.secret-scanning-sweep.plist,
# and safe to run by hand at any time. Usage:
#
#   sweep-secret-scanning [account]      # defaults to {{ .github_login }}
#   sweep-secret-scanning --dry-run      # report only, change nothing
#
# SAFETY: this refuses to act unless the authenticated gh account matches the
# expected one. On a work machine, where gh is signed in to a work account, it
# logs and exits without touching anything. Only public repositories are
# considered - private repositories need paid GitHub Secret Protection, and are
# reported as uncovered rather than modified.

set -uo pipefail

# launchd gives an agent a minimal PATH, so find Homebrew explicitly
for p in /opt/homebrew/bin /usr/local/bin; do
  [ -d "${p}" ] && PATH="${p}:${PATH}"
done
export PATH

expected="{{ .github_login }}"
dry_run=0

for arg in "$@"; do
  case "${arg}" in
    --dry-run) dry_run=1 ;;
    -*) echo "unknown option: ${arg}" >&2; exit 2 ;;
    *) expected="${arg}" ;;
  esac
done

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

if ! command -v gh >/dev/null 2>&1; then
  log "gh not found on PATH; nothing to do"
  exit 0
fi

# Guard 1: gh must be authenticated. Under launchd this can fail if the login
# keychain is locked, which is not an error worth alerting on - just skip.
if ! gh auth status >/dev/null 2>&1; then
  log "gh is not authenticated (keychain may be locked); skipping"
  exit 0
fi

# Guard 2: the authenticated account must be the expected one. This is what
# keeps the sweep away from work repositories.
actual="$(gh api user --jq .login 2>/dev/null)"
if [ -z "${actual}" ]; then
  log "could not determine the authenticated account; skipping"
  exit 0
fi
if [ "${actual}" != "${expected}" ]; then
  log "authenticated as '${actual}', expected '${expected}'; skipping (not this account's sweep)"
  exit 0
fi

log "sweeping public repositories for ${actual}$([ "${dry_run}" -eq 1 ] && echo ' (dry run)')"

repos="$(gh api "user/repos?per_page=100&affiliation=owner" --paginate \
  --jq '.[] | select(.visibility=="public") | .full_name' 2>/dev/null)"

if [ -z "${repos}" ]; then
  log "no public repositories found (or the API call failed); skipping"
  exit 0
fi

changed=0
already=0
failed=0

while read -r repo; do
  [ -n "${repo}" ] || continue

  status="$(gh api "repos/${repo}" \
    --jq '[(.security_and_analysis.secret_scanning.status // "unset"),
           (.security_and_analysis.secret_scanning_push_protection.status // "unset")]
          | join(",")' 2>/dev/null)"

  if [ "${status}" = "enabled,enabled" ]; then
    already=$((already + 1))
    continue
  fi

  if [ "${dry_run}" -eq 1 ]; then
    log "  would enable: ${repo} (currently ${status})"
    changed=$((changed + 1))
    continue
  fi

  if gh api -X PATCH "repos/${repo}" \
      -f 'security_and_analysis[secret_scanning][status]=enabled' \
      -f 'security_and_analysis[secret_scanning_push_protection][status]=enabled' \
      >/dev/null 2>&1; then
    log "  enabled: ${repo}"
    changed=$((changed + 1))
  else
    log "  FAILED:  ${repo}"
    failed=$((failed + 1))
  fi
done <<< "${repos}"

log "public repos: $((already + changed + failed)) - already enabled: ${already}, changed: ${changed}, failed: ${failed}"

# Report open alerts. Secret values are never fetched or printed - only counts.
alerts=0
repos_with_alerts=0
while read -r repo; do
  [ -n "${repo}" ] || continue
  n="$(gh api "repos/${repo}/secret-scanning/alerts?state=open" --jq 'length' 2>/dev/null)"
  case "${n}" in ''|*[!0-9]*) continue ;; esac
  if [ "${n}" -gt 0 ]; then
    log "  ALERT: ${repo} has ${n} open secret scanning alert(s)"
    alerts=$((alerts + n))
    repos_with_alerts=$((repos_with_alerts + 1))
  fi
done <<< "${repos}"

if [ "${alerts}" -gt 0 ]; then
  log "open alerts: ${alerts} across ${repos_with_alerts} repo(s) - review at https://github.com/${actual}"
else
  log "open alerts: none"
fi

# Private repositories cannot be covered without paid GitHub Secret Protection.
private_count="$(gh api "user/repos?per_page=100&affiliation=owner" --paginate \
  --jq '[.[] | select(.visibility=="private")] | length' 2>/dev/null | paste -sd+ - | bc 2>/dev/null)"
if [ -n "${private_count}" ] && [ "${private_count}" -gt 0 ] 2>/dev/null; then
  log "note: ${private_count} private repo(s) not covered (needs paid Secret Protection); rely on local hooks there"
fi

[ "${failed}" -eq 0 ] || exit 1
exit 0
