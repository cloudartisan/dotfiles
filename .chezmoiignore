# Files to ignore when applying chezmoi configuration

# Repository files
LICENSE
README.md
/CLAUDE.md
docs/
bootstrap-chezmoi.sh
.git/

# ctags index generated in the source checkout. Gitignored, so it never
# reaches a fresh clone, but chezmoi reads the working tree rather than the
# index and would otherwise deploy it to ~/tags.
tags

# Personal-only package list: deploy to ~ on personal machines only, so the
# install_brew/upgrade_brew helpers can detect it. Work machines skip it.
{{ if not .personal }}
Brewfile.personal
{{ end }}

# Personal-only automation: the weekly sweep that re-enables GitHub secret
# scanning on public repositories. Work machines are signed in to a work
# GitHub account whose repositories are managed centrally, so neither the
# launch agent nor the script belongs there. The script carries its own
# account guard as well, so this is defence in depth rather than the only
# thing standing between the sweep and a work account.
{{ if not .personal }}
Library/LaunchAgents/com.cloudartisan.secret-scanning-sweep.plist
bin/sweep-secret-scanning
{{ end }}

# Shell history files
.bash_history
.zsh_history
.python_history
.lesshst

# Sensitive credentials
.aws/
.sshcreds
.DBcreds
.keys/
.tanium-user-key-encryption.key
.vpn/
.cisco/

# Application directories
.cache/
# Claude Code: everything under ~/.claude is session state, history, caches
# and machine-local settings, so ignore it all by default. The one exception
# is CLAUDE.md, the global instructions file, which is worth managing.
# Note: this ignores the contents rather than the directory itself - chezmoi
# cannot re-include a file whose parent directory is ignored.
.claude/*
!.claude/CLAUDE.md
.claude.json
.lemminx/
.npm/
.redhat/
.m2/
.bundle/
.cursor/
.docker/
.vscode/
.local/
.gradle/
.jenkins/
.zoom/
.zsh_sessions/


# Vim (managed by separate dotvim repository)
.vim/
.vimrc
.gvimrc

# Temporary & system files
.Trash/
.DS_Store
.CFUserTextEncoding
*.swp
*~

# zsh runtime files
.zcompdump*
