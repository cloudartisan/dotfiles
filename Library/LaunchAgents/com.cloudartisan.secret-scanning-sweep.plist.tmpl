<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly sweep re-enabling GitHub secret scanning and push protection on public
  repositories, because a personal account cannot default them on for new
  repositories.

  Deployed on personal machines only - see .chezmoiignore. The script applies a
  second, independent guard: it refuses to act unless the authenticated gh
  account is {{ .github_login }}, so a work machine is never touched even if
  this plist somehow arrives there.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cloudartisan.secret-scanning-sweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/bin/sweep-secret-scanning</string>
    </array>

    <!-- Mondays at 10:00. If the machine is asleep, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do not run at login; the weekly schedule is enough and a login-time
         run would fire before the keychain is reliably unlocked. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/secret-scanning-sweep.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/secret-scanning-sweep.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Low priority: this is housekeeping, never urgent. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
