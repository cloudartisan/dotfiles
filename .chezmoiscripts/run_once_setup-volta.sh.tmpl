#!/bin/bash

# Set up Volta for per-project Node version management.
# Runs after the Brewfile install (brew "volta") provides the binary; the
# filename sorts after run_once_install-packages so `volta` is on PATH here.
# This script runs once when chezmoi is applied.

set -e

# Guard: nothing to do until the Brewfile has installed Volta
if ! command -v volta >/dev/null 2>&1; then
  echo "volta not found on PATH; skipping (Brewfile installs it first)"
  exit 0
fi

echo "==> Setting up Volta"

# Install Volta's shims into $VOLTA_HOME/bin. This also appends VOLTA_HOME/PATH
# exports to a zsh startup file; node.zsh is the single source of truth for
# those, so the export lines are stripped again below.
volta setup

# Provide a default Node so `node` works outside pinned projects. Projects
# that pin their own version auto-override this.
volta install node@lts

# Strip the VOLTA_HOME/PATH lines volta setup appends, so node.zsh stays the
# only place that sets them (avoids duplicate PATH entries, and drift in the
# chezmoi-managed ~/.zshrc which would otherwise show as a modified target).
# volta setup writes to ~/.zshrc and ~/.profile; only those are touched, and
# files are only rewritten in place, never deleted.
for profile in "${HOME}/.zshrc" "${HOME}/.profile"; do
  [ -f "${profile}" ] || continue
  if grep -q 'VOLTA_HOME' "${profile}"; then
    grep -v -e 'VOLTA_HOME' -e '\$VOLTA_HOME/bin' "${profile}" > "${profile}.tmp" \
      && mv "${profile}.tmp" "${profile}"
    rm -f "${profile}.tmp"
  fi
done

echo "✓ Volta configured ($(volta --version)); default Node installed"
