#!/bin/bash

# Load (or reload) the weekly secret-scanning sweep launch agent.
#
# run_onchange rather than run_once: the hash below changes whenever the plist
# changes, so an edited schedule is actually reloaded rather than sitting
# deployed but inert.
#
# plist hash: {{ include "private_Library/LaunchAgents/com.cloudartisan.secret-scanning-sweep.plist.tmpl" | sha256sum }}

set -e

{{ if not .personal -}}
echo "Work machine (personal = false); secret-scanning sweep not installed"
exit 0
{{ end -}}

label="com.cloudartisan.secret-scanning-sweep"
plist="${HOME}/Library/LaunchAgents/${label}.plist"

if [ ! -f "${plist}" ]; then
  echo "${plist} not deployed; skipping launch agent load"
  exit 0
fi

# Logs directory must exist before launchd can write StandardOutPath
mkdir -p "${HOME}/Library/Logs"

echo "==> Loading ${label}"

# Unload an existing copy first so an edited plist actually takes effect.
# bootout fails when nothing is loaded, which is fine.
launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "${plist}"

echo "✓ ${label} loaded (weekly; logs to ~/Library/Logs/secret-scanning-sweep.log)"
